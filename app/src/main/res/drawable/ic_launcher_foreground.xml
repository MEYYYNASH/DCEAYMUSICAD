<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Subtle Outer Geometric Octagon Frame -->
    <path
        android:pathData="M54,20 L80,31 L88,54 L80,77 L54,88 L28,77 L20,54 L28,31 Z"
        android:fillColor="#140D1B2A"
        android:strokeWidth="1.8">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="20"
                android:startY="20"
                android:endX="88"
                android:endY="88"
                android:type="linear">
                <item android:offset="0.0" android:color="#00FFFF" />
                <item android:offset="0.5" android:color="#3B82F6" />
                <item android:offset="1.0" android:color="#FF00FF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Sharp Angular White DCEAY Monogram Left Wing ('D' / Blade) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M31,32 L52,25 L52,35 L39,40 L39,68 L52,73 L52,83 L31,75 Z" />

    <!-- Sharp Angular White DCEAY Monogram Right Wing (Play / Lightning Apex) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M56,25 L79,43 L64,54 L79,65 L56,83 L56,71 L68,62 L54,54 L68,46 L56,37 Z" />

    <!-- Electric Cyan Core Slash -->
    <path
        android:pathData="M45,54 L59,45 L55,54 L59,63 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="45"
                android:startY="45"
                android:endX="60"
                android:endY="63"
                android:type="linear">
                <item android:offset="0.0" android:color="#00FFFF" />
                <item android:offset="1.0" android:color="#FF00FF" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
